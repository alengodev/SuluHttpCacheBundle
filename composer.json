{
    "name": "alengo/sulu-http-cache-bundle",
    "type": "symfony-bundle",
    "description": "HTTP cache helpers for Sulu/Symfony: strip tracking query parameters and store CTA marketing-attribution cookies at the reverse-proxy layer.",
    "keywords": [
        "sulu",
        "symfony",
        "http-cache",
        "fos",
        "marketing"
    ],
    "homepage": "https://github.com/alengodev/SuluHttpCacheBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexander Huber-De Monte"
        }
    ],
    "require": {
        "php": "^8.2",
        "friendsofsymfony/http-cache": "^3.0",
        "symfony/config": "^7.2",
        "symfony/dependency-injection": "^7.2",
        "symfony/event-dispatcher": "^7.2",
        "symfony/http-foundation": "^7.2",
        "symfony/http-kernel": "^7.2",
        "symfony/yaml": "^7.2"
    },
    "require-dev": {
        "php-cs-fixer/shim": "^3.93",
        "rector/rector": "^2.3"
    },
    "scripts": {
        "phpstan": "@php vendor/bin/phpstan analyze"
    },
    "autoload": {
        "psr-4": {
            "Alengo\\SuluHttpCacheBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alengo\\SuluHttpCacheBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    }
}
